/* Pulse CLI Modern Cyber-Dark Theme */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

Header {
    dock: top;
    height: 1;
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
}

Footer {
    dock: bottom;
    height: 1;
    background: #161b22;
    color: #8b949e;
}

#main-container {
    height: 1fr;
    width: 100%;
}

#left-panel {
    width: 38%;
    min-width: 34;
    max-width: 52;
    height: 100%;
    margin-right: 1;
}

#right-panel {
    width: 1fr;
    height: 100%;
}

/* Modals & Dialogs */
HelpModal {
    align: center middle;
}

#dialog-container {
    width: 72;
    height: auto;
    max-height: 85%;
    border: round #00f0ff;
    background: #161b22;
    padding: 1 2;
}

#dialog-title {
    text-align: center;
    color: #00f0ff;
    text-style: bold;
    margin-bottom: 1;
}

#dialog-body {
    height: auto;
    color: #c9d1d9;
    margin-bottom: 1;
}

#dialog-close-btn {
    width: 100%;
    background: #238636;
    color: #ffffff;
    text-style: bold;
    border: none;
    height: 3;
}

#dialog-close-btn:hover {
    background: #2ea043;
}

/* Directory Tree Custom Styling */
DirectoryTree {
    background: #0d1117;
    color: #c9d1d9;
    scrollbar-color: #30363d;
    scrollbar-color-hover: #58a6ff;
    scrollbar-color-active: #00f0ff;
}

DirectoryTree:focus {
    border: round #00f0ff;
}

DirectoryTree > .directory-tree--folder {
    color: #e3b341;
    text-style: bold;
}

DirectoryTree > .directory-tree--file {
    color: #58a6ff;
}

DirectoryTree > .directory-tree--extension {
    color: #00f0ff;
    text-style: bold;
}

/* Data Table Custom Styling */
DataTable {
    background: #0d1117;
    color: #c9d1d9;
    scrollbar-color: #30363d;
    scrollbar-color-hover: #58a6ff;
    scrollbar-color-active: #00f0ff;
}

DataTable:focus {
    border: round #a855f7;
}

DataTable > .datatable--cursor {
    background: #1f293d;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #161b22;
}
